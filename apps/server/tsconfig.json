{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "ESNext", "moduleResolution": "Bundler",
    "types": ["node"], "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "experimentalDecorators": true, "verbatimModuleSyntax": true, "isolatedModules": true,
    "noEmit": true, "skipLibCheck": false
  },
  "include": ["src", "prisma.config.ts"]
}
