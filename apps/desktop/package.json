{
  "name": "@deskbrawl/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "network:config": "node scripts/configure-network.mjs"
  },
  "dependencies": {
    "@deskbrawl/game-core": "workspace:*",
    "@deskbrawl/protocol": "workspace:*",
    "@tanstack/react-query": "5.104.5",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-deep-link": "2.6.2",
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
