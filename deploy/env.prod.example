# 서버에서 이 파일을 저장소 루트의 .env.prod로 복사해 값을 채운다. .env.prod는 커밋하지 않는다(.gitignore 대상).
#   cp deploy/env.prod.example .env.prod && chmod 600 .env.prod
# 비밀값 생성: openssl rand -hex 24   (URL에 들어가므로 hex를 쓴다)
POSTGRES_PASSWORD=replace-me
JWT_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_ORIGIN=https://api.deskbrawl.xyz
CLIENT_ORIGINS=http://tauri.localhost,tauri://localhost
# 아래 수명은 로컬 검증용 값이며 제품 확정 정책이 아니다(TBD).
ACCESS_TTL_SECONDS=3600
INVITE_TTL_SECONDS=86400
