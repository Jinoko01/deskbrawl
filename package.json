{
  "name": "deskbrawl",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @deskbrawl/desktop tauri dev",
    "dev:web": "pnpm --filter @deskbrawl/desktop dev",
    "dev:server": "pnpm --filter @deskbrawl/server dev",
    "build": "pnpm --filter @deskbrawl/desktop tauri build",
    "build:web": "pnpm --filter @deskbrawl/desktop build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm -r --parallel --if-present test:watch",
    "check": "pnpm lint && pnpm typecheck && pnpm build:web",
    "tauri:info": "pnpm --filter @deskbrawl/desktop tauri info"
  }
}
